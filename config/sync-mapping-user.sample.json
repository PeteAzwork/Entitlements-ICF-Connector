{
  "_comment": "Mapping skeleton as the discovery tool (design §12) generates it for managed/user. Orphans (target entities with no link: UNQUALIFIED, UNASSIGNED, TARGET_IGNORED) are REPORTed until correlation confidence is earned (§11, P16). A managed object deleted in IDM raises SOURCE_MISSING, which DELETEs the linked entity; a linked entity that has gone from the service raises MISSING, which re-CREATEs it (both confirmed in IDM 7.5, WS8.06). entityRelationships and directArchetypes are recomputed on EVERY update (§8.4): never add a condition to those two property mappings, and keep \"source\": \"\" on them, or IDM hands the transform an undefined source.",
  "name": "managedUser_systemGraphentityUser",
  "source": "managed/user",
  "target": "system/graphentity/user",
  "enableSync": true,
  "correlationQuery": {
    "type": "text/javascript",
    "source": "var qry = { '_queryFilter': '__NAME__ eq \"' + source.userName + '\"' }; qry;"
  },
  "properties": [
    {
      "source": "userName",
      "target": "__NAME__"
    },
    {
      "source": "name",
      "target": "name"
    },
    {
      "source": "mail",
      "target": "mail"
    },
    {
      "source": "telephoneNumber",
      "target": "telephoneNumber"
    },
    {
      "source": "",
      "target": "directArchetypes",
      "transform": {
        "type": "text/javascript",
        "source": "var lib = require('lib/graphEntityPayload'); lib.buildArchetypes(source, lib.loadTypeConfig('user'));"
      }
    },
    {
      "source": "",
      "target": "entityRelationships",
      "transform": {
        "type": "text/javascript",
        "source": "var lib = require('lib/graphEntityPayload'); lib.buildRelationships(source._id, lib.loadTypeConfig('user'));"
      }
    }
  ],
  "policies": [
    {
      "situation": "CONFIRMED",
      "action": "UPDATE"
    },
    {
      "situation": "FOUND",
      "action": "UPDATE"
    },
    {
      "situation": "ABSENT",
      "action": "CREATE"
    },
    {
      "situation": "AMBIGUOUS",
      "action": "EXCEPTION"
    },
    {
      "situation": "MISSING",
      "action": "CREATE"
    },
    {
      "situation": "UNQUALIFIED",
      "action": "REPORT"
    },
    {
      "situation": "UNASSIGNED",
      "action": "REPORT"
    },
    {
      "situation": "TARGET_IGNORED",
      "action": "REPORT"
    },
    {
      "situation": "SOURCE_IGNORED",
      "action": "REPORT"
    },
    {
      "situation": "SOURCE_MISSING",
      "action": "DELETE"
    },
    {
      "situation": "FOUND_ALREADY_LINKED",
      "action": "EXCEPTION"
    },
    {
      "situation": "LINK_ONLY",
      "action": "EXCEPTION"
    },
    {
      "situation": "ALL_GONE",
      "action": "IGNORE"
    }
  ]
}
